# Copy values into Cloud Run env / Secret Manager — do not commit real secrets.
# Full steps: docs/GCP.md + deploy/cloudrun/provision.sh + deploy.sh

APP_NAME="VERA"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE-XXXX.run.app
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_--show

CLOUD_RUN=true
FORCE_HTTPS=true
LOG_CHANNEL=stderr
PORT=8080

# Cloud SQL Unix socket (set by deploy.sh via --add-cloudsql-instances)
DB_CONNECTION=pgsql
DB_HOST=/cloudsql/PROJECT_ID:REGION:dapursense-pg
DB_PORT=5432
DB_DATABASE=kitchen_intelligence
DB_USERNAME=dapursense
# DB_PASSWORD → Secret Manager secret "db-password"

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Demo: local disk inside container. Optional later: FILESYSTEM_DISK=gcs + HMAC keys
FILESYSTEM_DISK=local
KITCHEN_STORAGE_DISK=local

# Gen AI — stub until Gemini key is in Secret Manager
AI_PROVIDER=stub
# AI_PROVIDER=gemini
# GEMINI_API_KEY → Secret Manager "gemini-api-key"
GEMINI_MODEL=gemini-2.5-flash

MIGRATE_ON_BOOT=1

# Optional GCS (S3-compat HMAC)
# FILESYSTEM_DISK=gcs
# KITCHEN_STORAGE_DISK=gcs
# GCS_BUCKET=vera-media-PROJECT_ID
# GCS_ACCESS_KEY_ID=
# GCS_SECRET_ACCESS_KEY=
# GCS_ENDPOINT=https://storage.googleapis.com
